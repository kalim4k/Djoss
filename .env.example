# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="YOUR_GEMINI_API_KEY"

# ANTHROPIC_API_KEY: Optional API key for Anthropic Claude report generation.
# If set, Djoss will prioritize Anthropic Claude for generating detailed reports.
ANTHROPIC_API_KEY="YOUR_ANTHROPIC_API_KEY"
ANTHROPIC_MODEL="claude-haiku-4-5"

# ELEVENLABS_API_KEY: Optional key for ElevenLabs v3 voice synthesis.
# If missing, Djoss gracefully falls back to Gemini TTS or browser speech.
ELEVENLABS_API_KEY="YOUR_ELEVENLABS_API_KEY"
ELEVENLABS_VOICE_ID="YOUR_ELEVENLABS_VOICE_ID"
ELEVENLABS_MODEL_ID="eleven_v3"

# SUPABASE: Optional database for storing project states, reports, photos and slug URLs (/XXXXXX)
SUPABASE_URL="YOUR_SUPABASE_URL"
SUPABASE_ANON_KEY="YOUR_SUPABASE_ANON_KEY"
SUPABASE_SERVICE_KEY="YOUR_SUPABASE_SERVICE_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"
